# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (Project Settings > API Keys) ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy "service_role" key. Server only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider ---
# One of: google (free tier), anthropic, openai. Defaults to google.
LLM_PROVIDER=google
# Optional model override. Defaults: google=gemini-3.8-flash, anthropic=claude-sonnet-5, openai=gpt-5-mini
# LLM_MODEL=

# Required for the provider you selected above.
# Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional: any OpenAI-compatible gateway, e.g. https://apinex.bond/v1 (use with LLM_PROVIDER=openai).
# OPENAI_BASE_URL=
